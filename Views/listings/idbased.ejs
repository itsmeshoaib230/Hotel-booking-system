<% layout("/layouts/boilerplate.ejs") %>

    <body>
        <div class="row">
            <div class="col-8 offset-3">
                <h2 class="edit-heading">
                    <%=particularlist.title %>
                </h2>
                <div class="card listing-card">
                    <div class="col-8">
                        <img class="card-img-top edit-img" src="<%=particularlist.image.url%>" alt="Card image cap">
                    </div>
                    <div class="col-8">
                        <div class="card-body">
                            <p class="card-text"> Owned by <%=particularlist.owner.username %>.</p>
                            <p class="card text ss"><%= particularlist.description %></p>
                            <p class="card-text">&#8377;<%= particularlist.price.toLocaleString("en-IN") %>/night </p>
                            <p class="card-text">  <%= particularlist.location %> </p>
                            <p class="card-text"><%= particularlist.country %> </p>
                        </div>
                    </div>
                </div>
                <% if(logpage && logpage._id.equals(particularlist.owner._id)){ %>
                <div class="id-btn">
                    <form method="get" action="/listing/<%= particularlist._id %>/edit">
                        <button type="submit" class="btn btn-danger edit-btn">Edit details</button>
                    </form>
                    <br>
                    <form method="post" action="/listing/<%=particularlist.id%>/delete?_method=delete">
                        <button type="submit" class="btn btn-dark">Delete</button>
                    </form>
                </div>
                <% } %>
                <br>
        <div class="row">
            <!-- <div class="reviews col-8 offset-3"> -->
                <% if(logpage){ %>
                <hr>
                <h4>Drop a Review</h4>
                <form method="POST" action="/listing/<%= particularlist._id %>/reviews" novalidate class="needs-validation">
                    <div class="mb-3 mt-3">
                        <label for="rating" class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                    </div>
                    <div class="mb-3 mt-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea rows="5" cols="20" name="review[comment]" class="form-control" id="comment"
                            required></textarea>
                        <div class="invalid-feedback">write a review</div>
                    </div>
                    <br>
                    <button type="submit" class="btn btn-success">Add Review</button>
                </form>
            <!-- </div> -->
        </div>
        <br>
        <% } %>
        <div class="row">
            <!-- <div class="col-8 offset-3"> -->
                <hr>
                <p><b>All Reviews:</b></p>
                <% for(review of particularlist.review){ %>
                    <div class="card col-5 ms-2 mb-2">
                        <div class="card-body">
                        <div class="card-title"><b>@<%= review.Author.username %></b></div>
                        <p class="starability-result" data-rating="<%= review.rating %>">
                        </p>
                        <p class="card-text">
                            <%= review.comment %>
                        </p>
    
                    </div>
                    <% if(logpage){ %>
                    <form class="mb-2 mt-2" method="POST" action="/listing/<%= particularlist._id %>/review/<%= review._id %>?_method=DELETE">
                        <button class="btn btn-dark">delete</button>
                    </form>
                    <% }%>
                    </div>

                    <% } %>
            <!-- </div> -->
        </div>
        </div>
        </div>
    </body>