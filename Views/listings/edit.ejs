<% layout("/layouts/boilerplate.ejs") %>
<body>
    <div class="row">
    <form method="post" action="/listing/<%=obj._id %>/edit?_method=PUT">
        <div class="col-8 offset-2">
            <h3>Edit Details:</h3>
        <div class="mb-3">
        <lable for="title" class="form-label edit-form">Title:</lable>
        <input type="text" name="listing[title]" placeholder="<%=obj.title %>" value="<%=obj.title%>" class="form-control">
        </div>
        <div class="mb-3">
        <lable for="description" class="form-label edit-form">Description:</lable>
        <textarea type="text" name="listing[description]"  class="form-control"><%=obj.description %></textarea>
        </div>
    <div class="row">
        <div class="col-4">
        <div class="mb-3">
        <lable for="imagefilename" class="form-label edit-form">ImageText:</lable>
         <input type="text" name="listing[image][filename]" value="<%= obj.image.filename %>" class="form-control">
        </div>
        </div>
        <div class="col-8">
        <div class="mb-3">
        <lable for="imageurl" class="form-label edit-form">ImageUrl:</lable>
         <input type="text" name="listing[image][url]" value="<%= obj.image.url %>" class="form-control">
        </div>
        </div>
    </div>
        
        <div class="mb-3">
        <lable for="price" class="form-label edit-form">Price:</lable>
         <input type="Number" name="listing[price]" value="<%=obj.price %>" class="form-control">
        </div>
        <div class="mb-3">
            <lable for="location" class="form-lable edit-form">Location:</lable>
            <input type="text" name="listing[location]" value="<%=obj.location %>" class="form-control">
        </div>
        <div class="mb-3">
            <lable for="country" class="form-lable edit-form">Country:</lable>
            <input type="text" name="listing[country]" value="<%=obj.country %>" class="form-control">
        </div>
        <br>
        <button type="submit" class="btn btn-dark edit-btn">Edit</button>
        </div>
    </form>
    </div>
</body>
