<% layout("/layouts/boilerplate.ejs") %>
<body>
    <h3 class="indexejs">List Of Available Places:</h3>
    <div class="row row-cols-lg-3 row-cols-md-3 row-cols-1">
     <% for(let details of listingdetails){ %>
        <a class="cardanch" href="/listing/<%=details._id %>">
        <div class="card listing-card">
        <img class="card-img-top" src="<%=details.image.url%>" alt="Card image cap" style="height:18rem;">
        <div class="card-img-overlay"></div>
        <div class="card-body">
        <p class="card-text">
            <b><%=details.title %></b> <br>
            &#8377;<%= details.price.toLocaleString("en-IN") %>/night
        </p>
        </div>
        </div>
        </a>
     <% } %>
     </div>
</body>
